@page "/auth/forced-password-change"
@layout LoginLayout
@using FluentValidation
@inject IAuthService AuthService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject ICookieSignInService CookieSignInService
@inject NavigationManager Navigation
@inject IValidator<ChangePasswordRequest> PasswordValidator

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo" style="background: linear-gradient(135deg, #f59e0b, #d97706);">🔑</div>
        <h2>Change Password</h2>
        <p>Your account requires a mandatory password update before proceeding.</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-banner danger">
            <span>⚠️ @errorMessage</span>
        </div>
    }

    <EditForm Model="changeModel" OnValidSubmit="HandlePasswordChange">
        <div class="form-group">
            <label class="form-label">New Password (Min 8 characters)</label>
            <input type="password" class="form-control" @bind="changeModel.NewPassword" placeholder="••••••••••••" required minlength="8" />
        </div>

        <div class="form-group">
            <label class="form-label">Confirm New Password</label>
            <input type="password" class="form-control" @bind="changeModel.ConfirmPassword" placeholder="••••••••••••" required minlength="8" />
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;" disabled="@isLoading">
            @if (isLoading)
            {
                <span>Updating Password...</span>
            }
            else
            {
                <span>✓ Save Password & Continue</span>
            }
        </button>
    </EditForm>
</div>

@code {
    private ChangePasswordRequest changeModel = new();
    private string? errorMessage;
    private bool isLoading = false;

    private async Task HandlePasswordChange()
    {
        var session = AuthStateProvider.CurrentUserSession;
        if (session == null)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        if (changeModel.NewPassword != changeModel.ConfirmPassword)
        {
            errorMessage = "New password and confirmation do not match.";
            return;
        }

        var validation = await PasswordValidator.ValidateAsync(changeModel);
        if (!validation.IsValid)
        {
            errorMessage = validation.Errors.First().ErrorMessage;
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            changeModel.UserId = session.Id;
            var success = await AuthService.ChangePasswordAsync(changeModel);
            if (success)
            {
                session.MustChangePassword = false;
                await CookieSignInService.RefreshAsync(session);

                switch (session.Role)
                {
                    case UserRole.SuperAdmin:
                        Navigation.NavigateTo("/superadmin/dashboard", true);
                        break;
                    case UserRole.DistrictAdmin:
                        Navigation.NavigateTo("/district/dashboard", true);
                        break;
                    case UserRole.SchoolAdmin:
                        Navigation.NavigateTo("/school/dashboard", true);
                        break;
                }
            }
            else
            {
                errorMessage = "Failed to update password. Please try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Failed to update password. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
