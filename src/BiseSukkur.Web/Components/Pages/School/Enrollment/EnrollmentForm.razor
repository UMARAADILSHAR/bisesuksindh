        PreviousBoard = "BISE Sukkur"
    };

    private string? errorMessage;
    private string? successMessage;
    private bool isSaving = false;
    private bool dobAgeWarning = false;
    private bool showPreviewDialog = false;
    private string activeYearName = "2025 – 2026";
    private string selectedPreviousBoard = "BISE Sukkur";
    private string? photoPreviewBase64;
    private IBrowserFile? photoFile;
    private byte[]? pendingPhotoBytes;
    private string? pendingPhotoContentType;
    private string? pendingPhotoFileName;
    private WindowStatusSummaryDto? enrollmentWindow;
    private bool _isDirty;
    private IDisposable? _locationChangingRegistration;

    private string prevSeatNo = "";
    private string prevPassingYear = "2025";

    // Date picker dialog
    private bool showDatePickerDialog = false;
    private DateTime? tempDate;
    private string currentDateField = "";
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private DialogOptions previewDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    private DateTime? DobValue => student.DateOfBirth == default ? null : student.DateOfBirth;

    private void ShowPreviewDialog()
    {
        showPreviewDialog = true;
        StateHasChanged();
    }

    private void ClosePreviewDialog()
    {
        showPreviewDialog = false;
        StateHasChanged();
    }

    private void ShowDatePicker(string field)
    {
        currentDateField = field;
        tempDate = field switch
        {
            "dob" => student.DateOfBirth,
            "admission" => student.AdmissionDate,
            "boardPassing" => student.BoardPassingDate,
            _ => DateTime.Today
        };
        showDatePickerDialog = true;
    }

    private void ConfirmDatePicker()
    {
        if (tempDate.HasValue)
        {
            switch (currentDateField)
            {
                case "dob":
                    student.DateOfBirth = tempDate.Value;
                    OnDobChanged();
                    break;
                case "admission":
                    student.AdmissionDate = tempDate;
                    break;
                case "boardPassing":
                    student.BoardPassingDate = tempDate;
                    break;
            }
            MarkDirty();
        }
        showDatePickerDialog = false;
    }

    private void CancelDatePicker()
    {
        showDatePickerDialog = false;
    }

    private string FormatDateDisplay(DateTime? date)
    {
        if (date == null) return "";
        return date.Value.ToString("dd-MMM-yyyy");
    }

    private void OnSmartDateChanged(string input, Action<DateTime?> setter)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            setter(null);
            MarkDirty();
            return;
        }

        DateTime parsed;
        
        // Format: dd-MMM-yyyy (01-Jan-2010) - Preferred format
        if (DateTime.TryParseExact(input, "dd-MMM-yyyy", 
            System.Globalization.CultureInfo.InvariantCulture, 
            System.Globalization.DateTimeStyles.None, out parsed))
        {
            setter(parsed);
            MarkDirty();
            return;
        }

        // Format: ddMMMyyyy (01Jan2010) - Without hyphens
        if (DateTime.TryParseExact(input, "ddMMMyyyy", 
            System.Globalization.CultureInfo.InvariantCulture, 
            System.Globalization.DateTimeStyles.None, out parsed))
        {
            setter(parsed);
            MarkDirty();
            return;
        }

        // Format: ddMMyyyy (01012010) - All digits
        if (input.Length == 8 && DateTime.TryParseExact(input, "ddMMyyyy",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out parsed))
        {
            setter(parsed);
            MarkDirty();
            return;
        }

        // Try standard parsing for other formats
        if (DateTime.TryParse(input, out parsed))
        {
            setter(parsed);
            MarkDirty();
            return;
        }

        // Invalid format - don't update
    }

    protected override async Task OnInitializedAsync()
    {
        _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);

        var session = AuthStateProvider.CurrentUserSession;
        var activeYear = await WindowService.GetActiveAcademicYearAsync();
        int schoolId = session?.SchoolId ?? 1;

        enrollmentWindow = await WindowService.GetWindowStatusSummaryAsync("enrollment", schoolId);

        if (activeYear != null)
        {
            activeYearName = activeYear.YearName;
        }

        if (Id.HasValue && Id.Value > 0)
        {
            var existing = await EnrollmentService.GetEnrollmentByIdAsync(Id.Value);
            if (existing != null)
            {
                student = existing;
                selectedPreviousBoard = (existing.PreviousBoard == "BISE Sukkur" || string.IsNullOrEmpty(existing.PreviousBoard))
                    ? "BISE Sukkur"
                    : "Other";

                if (!string.IsNullOrEmpty(existing.PhotoPath))
                {
                    photoPreviewBase64 = existing.PhotoPath.StartsWith('/')
                        ? existing.PhotoPath
                        : $"/{existing.PhotoPath.TrimStart('/')}";
                }
            }
        }
        else
        {
            student.SchoolId = schoolId;
            student.AcademicYearId = activeYear?.Id ?? 1;
        }

        if (string.IsNullOrEmpty(student.Religion) || student.Religion == "Islam")
        {
            student.Religion = "Muslim";
        }

        if (student.DateOfBirth != default)
        {
            student.DateOfBirthWords = DateToWords(student.DateOfBirth);
        }

        EnforceStudentTypeRule();
    }

    private static bool IsHscLevel(string classLevel) =>
        classLevel.StartsWith("HSC", StringComparison.OrdinalIgnoreCase);

    private static bool IsStudentTypeLocked(string classLevel, string group)
    {
        var upperGroup = (group ?? "").ToUpperInvariant();
        if (classLevel.StartsWith("SSC", StringComparison.OrdinalIgnoreCase))
        {
            return upperGroup == "SCIENCE";
        }
        if (classLevel.StartsWith("HSC", StringComparison.OrdinalIgnoreCase))
        {
            return upperGroup == "PRE-MEDICAL" || upperGroup == "PRE-ENGINEERING";
        }
        return false;
    }

    private IEnumerable<string> GetGroupsForClass(string classLevel)
    {
        if (classLevel.StartsWith("SSC", StringComparison.OrdinalIgnoreCase))
        {
            return ["SCIENCE", "GENERAL REGULAR", "GENERAL PRIVATE"];
        }
        return ["PRE-MEDICAL", "PRE-ENGINEERING", "HUMANITIES REGULAR", "HUMANITIES PRIVATE", "COMMERCE"];
    }

    private void OnClassLevelChanged()
    {
        student.Group = GetGroupsForClass(student.ClassLevel).First();
        EnforceStudentTypeRule();
        MarkDirty();
    }

    private void OnGroupChanged()
    {
        EnforceStudentTypeRule();
        MarkDirty();
    }

    private void EnforceStudentTypeRule()
    {
        if (IsStudentTypeLocked(student.ClassLevel, student.Group))
        {
            student.StudentType = "FRESH";
        }
        else if (student.StudentType == "Regular" || string.IsNullOrEmpty(student.StudentType))
        {
            student.StudentType = "FRESH";
        }
    }

    private void SetMedium(string medium)
    {
        student.Medium = medium;
        MarkDirty();
    }

    private async Task FetchPreviousSscRecord()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(prevSeatNo))
        {
            errorMessage = "Please enter previous Seat / Roll No to fetch record.";
            return;
        }

        prevSeatNo = FilterDigitsOnly(prevSeatNo, 10);

        var old = await EnrollmentService.LookupPreviousSscRecordAsync(prevSeatNo, prevPassingYear);
        if (old != null)
        {
            student.StudentName = old.StudentName.ToUpperInvariant();
            student.FatherName = old.FatherName?.ToUpperInvariant();
            student.FatherCnic = FormatCnic(old.FatherCnic);
            student.Surname = old.Surname?.ToUpperInvariant();
            student.Cnic = FormatCnic(old.Cnic);
            student.DateOfBirth = old.DateOfBirth;
            student.DateOfBirthWords = old.DateOfBirthWords ?? DateToWords(old.DateOfBirth);
            student.Gender = old.Gender;
            student.Religion = (old.Religion == "Islam" || string.IsNullOrEmpty(old.Religion)) ? "Muslim" : old.Religion;
            student.Medium = old.Medium;
            student.Address = old.Address;
            student.IdentificationMark = old.IdentificationMark?.ToUpperInvariant();
            student.MobileNumber = FormatMobile(old.MobileNumber);
            student.BoardRegNo = old.EnrollmentNumber ?? old.BoardRegNo ?? prevSeatNo;
            student.PreviousBoard = "BISE Sukkur";
            selectedPreviousBoard = "BISE Sukkur";

            successMessage = $"Record fetched successfully for candidate '{student.StudentName}' (SSC Roll #{prevSeatNo}).";
            MarkDirty();
        }
        else
        {
            errorMessage = $"No previous record found in BISE database for Seat #{prevSeatNo}. You can enter candidate details manually.";
        }
    }

    private void OnPreviousBoardChanged()
    {
        if (selectedPreviousBoard == "BISE Sukkur")
            student.PreviousBoard = "BISE Sukkur";
        MarkDirty();
    }

    private void OnAdmissionDateChanged(DateTime? value)
    {
        student.AdmissionDate = value;
        MarkDirty();
    }

    private void OnBoardPassingDateChanged(DateTime? value)
    {
        student.BoardPassingDate = value;
        MarkDirty();
    }

    private void OnDobPicked(DateTime? value)
    {
        if (value.HasValue)
        {
            student.DateOfBirth = value.Value;
            OnDobChanged();
        }
        MarkDirty();
    }

    private void OnDobChanged()
    {
        var dob = student.DateOfBirth;
        var today = DateTime.Today;
        int age = today.Year - dob.Year;
        if (today < dob.AddYears(age)) age--;

        dobAgeWarning = dob > today || age < 10 || age > 35;
        student.DateOfBirthWords = DateToWords(dob);
    }

    private static string FilterTextOnly(string? input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        return Regex.Replace(input, @"[^a-zA-Z\s\.\-']", "").ToUpperInvariant();
    }

    private static string FilterDigitsOnly(string? input, int maxLen = 20)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        var digits = Regex.Replace(input, @"\D", "");
        return digits.Length > maxLen ? digits[..maxLen] : digits;
    }

    private static string FormatCnic(string? input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        var digits = Regex.Replace(input, @"\D", "");
        if (digits.Length > 13) digits = digits[..13];
        if (digits.Length <= 5) return digits;
        if (digits.Length <= 12) return $"{digits[..5]}-{digits[5..]}";
        return $"{digits[..5]}-{digits[5..12]}-{digits[12..]}";
    }

    private static string FormatMobile(string? input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        var digits = Regex.Replace(input, @"\D", "");
        if (digits.Length > 11) digits = digits[..11];
        if (digits.Length <= 4) return digits;
        return $"{digits[..4]}-{digits[4..]}";
    }

    private void OnCnicChanged()
    {
        student.Cnic = FormatCnic(student.Cnic);
        MarkDirty();
    }

    private void OnFatherCnicChanged()
    {
        student.FatherCnic = FormatCnic(student.FatherCnic);
        MarkDirty();
    }

    private void OnMobileChanged()
    {
        student.MobileNumber = FormatMobile(student.MobileNumber);
        MarkDirty();
    }

    private static string DateToWords(DateTime d)
    {
        string[] ordinals = ["ZERO", "FIRST", "SECOND", "THIRD", "FOURTH", "FIFTH", "SIXTH", "SEVENTH", "EIGHTH", "NINTH", "TENTH",
            "ELEVENTH", "TWELFTH", "THIRTEENTH", "FOURTEENTH", "FIFTEENTH", "SIXTEENTH", "SEVENTEENTH", "EIGHTEENTH", "NINETEENTH", "TWENTIETH",
            "TWENTY-FIRST", "TWENTY-SECOND", "TWENTY-THIRD", "TWENTY-FOURTH", "TWENTY-FIFTH", "TWENTY-SIXTH", "TWENTY-SEVENTH", "TWENTY-EIGHTH", "TWENTY-NINTH", "THIRTIETH", "THIRTY-FIRST"];
        string[] months = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"];
        return $"{ordinals[d.Day]} {months[d.Month - 1]} {YearToWords(d.Year)}";
    }

    private static string YearToWords(int y)
    {
        string[] ones = ["", "ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT", "NINE", "TEN",
            "ELEVEN", "TWELVE", "THIRTEENTH", "FOURTEEN", "FIFTEEN", "SIXTEEN", "SEVENTEEN", "EIGHTEEN", "NINETEEN"];
        string[] tens = ["", "", "TWENTY", "THIRTY", "FORTY", "FIFTY", "SIXTY", "SEVENTY", "EIGHTY", "NINETY"];
        if (y < 20) return ones[y];
        if (y < 100) return tens[y / 10] + (y % 10 > 0 ? " " + ones[y % 10] : "");
        if (y < 1000) return ones[y / 100] + " HUNDRED" + (y % 100 > 0 ? " AND " + YearToWords(y % 100) : "");
        return YearToWords(y / 1000) + " THOUSAND" + (y % 1000 > 0 ? " " + YearToWords(y % 1000) : "");
    }

    private void MarkDirty() => _isDirty = true;

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        photoFile = e.File;
        if (photoFile.Size > 2 * 1024 * 1024)
        {
            errorMessage = "Photo exceeds 2 MB maximum size.";
            return;
        }
        using var stream = photoFile.OpenReadStream(2 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        pendingPhotoBytes = ms.ToArray();
        pendingPhotoContentType = photoFile.ContentType;
        pendingPhotoFileName = photoFile.Name;
        var base64 = Convert.ToBase64String(pendingPhotoBytes);
        photoPreviewBase64 = $"data:{photoFile.ContentType};base64,{base64}";
        _isDirty = true;
    }

    private void ClearPhoto()
    {
        photoPreviewBase64 = null;
        photoFile = null;
        pendingPhotoBytes = null;
        pendingPhotoContentType = null;
        pendingPhotoFileName = null;
        student.PhotoPath = null;
        _isDirty = true;
    }

    private void ResetFormForNextStudent()
    {
        var currentSchoolId = student.SchoolId;
        var currentAcademicYearId = student.AcademicYearId;
        var currentClassLevel = student.ClassLevel;
        var currentGroup = student.Group;
        var currentMedium = student.Medium;
        var currentReligion = student.Religion;
        var currentStudentType = student.StudentType;

        student = new Enrollment
        {
            SchoolId = currentSchoolId,
            AcademicYearId = currentAcademicYearId,
            ClassLevel = string.IsNullOrEmpty(currentClassLevel) ? "SSC-I" : currentClassLevel,
            Group = string.IsNullOrEmpty(currentGroup) ? "SCIENCE" : currentGroup,
            Medium = string.IsNullOrEmpty(currentMedium) ? "Sindhi" : currentMedium,
            Religion = string.IsNullOrEmpty(currentReligion) ? "Muslim" : currentReligion,
            StudentType = string.IsNullOrEmpty(currentStudentType) ? "FRESH" : currentStudentType,
            DateOfBirth = DateTime.Today.AddYears(-15),
            DateOfBirthWords = DateToWords(DateTime.Today.AddYears(-15))
        };

        photoPreviewBase64 = null;
        photoFile = null;
        pendingPhotoBytes = null;
        pendingPhotoContentType = null;
        pendingPhotoFileName = null;
        prevSeatNo = "";
        errorMessage = null;
        dobAgeWarning = false;
        _isDirty = false;
        EnforceStudentTypeRule();
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (_isDirty && !isSaving)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "You have unsaved changes. Are you sure you want to leave this page?");
            if (!confirmed)
            {
                context.PreventNavigation();
            }
        }
    }

    public void Dispose()
    {
        _locationChangingRegistration?.Dispose();
    }

    private void NormalizeForSave()
    {
        student.StudentName = FilterTextOnly(student.StudentName);
        student.FatherName = FilterTextOnly(student.FatherName);
        student.Surname = FilterTextOnly(student.Surname);
        student.IdentificationMark = FilterTextOnly(student.IdentificationMark);
        student.EligibilityNo = student.EligibilityNo?.ToUpperInvariant();
        if (selectedPreviousBoard == "Other")
            student.PreviousBoard = FilterTextOnly(student.PreviousBoard);
        else
            student.PreviousBoard = "BISE Sukkur";
        student.Cnic = FormatCnic(student.Cnic);
        student.FatherCnic = FormatCnic(student.FatherCnic);
        student.MobileNumber = FormatMobile(student.MobileNumber);
        prevSeatNo = FilterDigitsOnly(prevSeatNo, 10);
    }

    private async Task HandleSave(bool finalize)
    {
        errorMessage = null;
        successMessage = null;
        NormalizeForSave();

        if (string.IsNullOrWhiteSpace(student.StudentName))
        { errorMessage = "Candidate Full Name is required."; return; }
        if (string.IsNullOrWhiteSpace(student.Cnic))
        { errorMessage = "Candidate CNIC / B-Form is required."; return; }
        if (string.IsNullOrWhiteSpace(student.FatherName))
        { errorMessage = "Father's Name is required."; return; }
        if (string.IsNullOrWhiteSpace(student.Gender))
        { errorMessage = "Gender selection is required."; return; }
        if (dobAgeWarning)
        { errorMessage = "Candidate age must be between 10 and 35 years."; return; }

        var exists = await EnrollmentService.CheckCnicExistsAsync(student.Cnic, student.AcademicYearId, student.Id > 0 ? student.Id : null);
        if (exists)
        { errorMessage = $"A candidate with CNIC '{student.Cnic}' is already registered in this academic session."; return; }

        isSaving = true;
        try
        {
            student.SubjectsJson = "[]";
            var savedName = student.StudentName;
            var savedCnic = student.Cnic;
            var isEdit = student.Id > 0;

            var saved = await EnrollmentService.SaveEnrollmentAsync(student, finalize);

            if (pendingPhotoBytes != null && pendingPhotoBytes.Length > 0)
            {
                var webPath = await EnrollmentService.SaveEnrollmentPhotoAsync(
                    saved.SchoolId,
                    saved.Id,
                    pendingPhotoBytes,
                    pendingPhotoContentType ?? "image/jpeg",
                    pendingPhotoFileName ?? "photo.jpg");
                saved.PhotoPath = webPath;
                pendingPhotoBytes = null;
                pendingPhotoContentType = null;
                pendingPhotoFileName = null;
            }

            _isDirty = false;

            if (isEdit)
            {
                // Show top-right success snackbar for 6 seconds
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopEnd;
                Snackbar.Configuration.SnackbarVariant = Variant.Filled;
                Snackbar.Add($"✓ Candidate '{savedName}' record updated successfully!", Severity.Success, config =>
                {
                    config.VisibleStateDuration = 6000;
                    config.ShowCloseIcon = true;
                });
                
                await Task.Delay(1500);
                Navigation.NavigateTo("school/enrollments");
            }
            else
            {
                // Show top-right success snackbar for 6 seconds
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopEnd;
                Snackbar.Configuration.SnackbarVariant = Variant.Filled;
                Snackbar.Add($"✓ Candidate '{savedName}' ({savedCnic}) successfully enrolled! Form is ready for the next entry.", Severity.Success, config =>
                {
                    config.VisibleStateDuration = 6000;
                    config.ShowCloseIcon = true;
                });
                
                ResetFormForNextStudent();
                successMessage = $"Candidate '{savedName}' ({savedCnic}) successfully enrolled. Form is ready for the next entry.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            
            // Show error snackbar
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopEnd;
            Snackbar.Configuration.SnackbarVariant = Variant.Filled;
            Snackbar.Add($"✗ {ex.Message}", Severity.Error, config =>
            {
                config.VisibleStateDuration = 6000;
                config.ShowCloseIcon = true;
            });
        }
        finally
        {
            isSaving = false;
        }
    }
}
