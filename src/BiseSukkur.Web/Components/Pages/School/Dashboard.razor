@page "/school/dashboard"
@attribute [Authorize(Roles = "SchoolAdmin")]
@inject IReportService ReportService
@inject ISchoolService SchoolService
@inject IChallanService ChallanService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

@if (_hasError)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <span>@_errorMessage</span>
            <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Small" OnClick="LoadDashboardData">Retry</MudButton>
        </div>
    </MudAlert>
}
else
{
    <!-- 2x2 Compact KPI Cards -->
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border-radius: 12px; padding: 20px; color: white; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="font-size: 13px; opacity: 0.9; margin-bottom: 4px;">Enrolled Candidates</div>
                    <div style="font-size: 32px; font-weight: 700; line-height: 1;">@(stats?.TotalEnrollments ?? 0)</div>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Style="opacity: 0.3;" />
            </div>
        </div>

        <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 12px; padding: 20px; color: white; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="font-size: 13px; opacity: 0.9; margin-bottom: 4px;">Exam Form Entries</div>
                    <div style="font-size: 32px; font-weight: 700; line-height: 1;">@(stats?.TotalExams ?? 0)</div>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Style="opacity: 0.3;" />
            </div>
        </div>

        <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 12px; padding: 20px; color: white; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="font-size: 13px; opacity: 0.9; margin-bottom: 4px;">Pending Invoices</div>
                    <div style="font-size: 28px; font-weight: 700; line-height: 1; font-family: monospace;">Rs. @((stats?.PendingInvoicesAmount ?? 0).ToString("N0"))</div>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" Style="opacity: 0.3;" />
            </div>
        </div>

        <div style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border-radius: 12px; padding: 20px; color: white; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.2);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="font-size: 13px; opacity: 0.9; margin-bottom: 4px;">Reconciled Revenue</div>
                    <div style="font-size: 28px; font-weight: 700; line-height: 1; font-family: monospace;">Rs. @((stats?.PaidInvoicesAmount ?? 0).ToString("N0"))</div>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Large" Style="opacity: 0.3;" />
            </div>
        </div>
    </div>

    <!-- Class-wise Enrollment & Exam Progress Table -->
    <div class="card-surface" style="padding: 0; overflow: hidden; margin-top: 1.5rem;">
        <div style="padding: 0.85rem 1.15rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-subtle); background: #ffffff;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--text-primary);">
                Class-wise Enrollment & Examination Progress
            </div>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="school/gap-reports" EndIcon="@Icons.Material.Filled.ArrowForward">
                Gap Analysis Report
            </MudButton>
        </div>

        <div class="table-responsive">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th style="width: 25%;">Class Level</th>
                        <th style="width: 18%; text-align: center;">Enrolled Candidates</th>
                        <th style="width: 18%; text-align: center;">Exam Forms Submitted</th>
                        <th style="width: 18%; text-align: center;">Pending Exam Forms</th>
                        <th style="width: 21%;">Submission Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var progressRows = new[]
                        {
                            ("SSC-I (Class 9th)", stats?.Ssc1Enrollments ?? 0, stats?.Ssc1Exams ?? 0, "#0284c7"),
                            ("SSC-II (Class 10th)", stats?.Ssc2Enrollments ?? 0, stats?.Ssc2Exams ?? 0, "#059669"),
                            ("HSC-I (Class 11th)", stats?.Hsc1Enrollments ?? 0, stats?.Hsc1Exams ?? 0, "#7c3aed"),
                            ("HSC-II (Class 12th)", stats?.Hsc2Enrollments ?? 0, stats?.Hsc2Exams ?? 0, "#d97706")
                        };
                    }
                    @foreach (var (className, enrolled, examSubmitted, colorHex) in progressRows)
                    {
                        var pending = Math.Max(0, enrolled - examSubmitted);
                        var pct = enrolled > 0
                            ? Math.Min(100, Math.Round((decimal)examSubmitted / enrolled * 100, 1))
                            : 0;

                        <tr>
                            <td><strong>@className</strong></td>
                            <td style="text-align: center;" class="cell-mono">@enrolled</td>
                            <td style="text-align: center;" class="cell-mono">@examSubmitted</td>
                            <td style="text-align: center;" class="cell-mono">@pending</td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <div style="flex: 1; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden;">
                                        <div style="width: @pct%; height: 100%; background: @colorHex; border-radius: 3px; transition: width 0.6s ease;"></div>
                                    </div>
                                    <span style="font-size: 0.72rem; font-weight: 700; width: 38px; text-align: right;">@pct%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private SchoolDashboardStatsDto? stats;
    private bool _hasError = false;
    private string _errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        _hasError = false;
        _errorMessage = "";
        try
        {
            var session = AuthStateProvider.CurrentUserSession;
            int schoolId = session?.SchoolId ?? 1;
            stats = await ReportService.GetSchoolDashboardStatsAsync(schoolId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load school dashboard stats.");
            _hasError = true;
            _errorMessage = "Could not load dashboard information. Please try again.";
        }
    }
}
