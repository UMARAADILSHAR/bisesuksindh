@page "/print/certificate/{id:int}"
@attribute [Authorize]
@inject ICertificateService CertificateService
@inject IJSRuntime JSRuntime

@if (certificate == null)
{
    <p style="padding: 2rem;">Loading Official Board Certificate...</p>
}
else
{
    <div class="no-print" style="padding: 1rem 2rem; background: #1e293b; color: white; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <strong style="font-size: 1.1rem;">Official Passing Certificate</strong>
            <span style="font-size: 0.85rem; color: #94a3b8; margin-left: 1rem;">Certificate #: @certificate.CertificateNumber</span>
        </div>
        <button type="button" class="btn btn-primary" @onclick="Print">
            🖨️ Print Certificate
        </button>
    </div>

    <div class="print-page" style="display: flex; justify-content: center; padding: 25px; background: #f1f5f9;">
        <!-- Certificate Frame with Guilloche Double Border -->
        <div style="width: 850px; border: 8px solid #1e3a8a; outline: 3px double #d97706; outline-offset: -12px; padding: 40px; background: #fffdf5; font-family: 'Georgia', 'Times New Roman', serif; position: relative; box-shadow: 0 10px 25px rgba(0,0,0,0.15); text-align: center;">
            
            <!-- Watermark -->
            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0.03; font-size: 6rem; font-weight: 900; pointer-events: none; transform: rotate(-25deg);">
                BISE SUKKUR
            </div>

            <!-- Header -->
            <div style="margin-bottom: 25px;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #1e3a8a, #0ea5e9); border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; margin: 0 auto 10px auto; border: 3px solid #d97706;">
                    B
                </div>
                <h1 style="font-size: 1.7rem; font-weight: bold; color: #1e3a8a; margin: 0; letter-spacing: 0.04em;">
                    BOARD OF INTERMEDIATE & SECONDARY EDUCATION SUKKUR
                </h1>
                <h2 style="font-size: 1.2rem; font-weight: normal; font-style: italic; color: #d97706; margin: 6px 0 0 0;">
                    SECONDARY SCHOOL CERTIFICATE EXAMINATION
                </h2>
                <div style="font-size: 0.9rem; color: #666; margin-top: 4px;">
                    Statement of Marks & Provisional Passing Certificate
                </div>
            </div>

            <!-- Certificate Body -->
            <p style="font-size: 1.1rem; line-height: 2.2; text-align: justify; color: #1f2937; margin-bottom: 25px;">
                This is to certify that <strong style="color: #1e3a8a; text-decoration: underline; text-underline-offset: 4px; font-size: 1.25rem;">@certificate.StudentName</strong>,
                Son / Daughter of <strong style="color: #1e3a8a; text-decoration: underline; text-underline-offset: 4px;">@certificate.FatherName</strong>,
                bearing Registration Number <code>@certificate.EnrollmentNumber</code> and Examination Roll Number <strong style="color: #1e3a8a;">@certificate.RollNumber</strong>,
                of institution <strong style="color: #111;">@certificate.SchoolName</strong>,
                has successfully passed the <strong>@certificate.ClassLevel</strong> Annual Examination in <strong>@certificate.Group Group</strong>
                securing <strong style="color: #047857;">@certificate.TotalMarksObtained / @certificate.TotalMaxMarks Marks</strong>
                and is placed in Grade <strong style="font-size: 1.3rem; color: #047857; background: #e0f2fe; padding: 2px 10px; border-radius: 4px; border: 1px solid #7dd3fc;">@certificate.Grade</strong>.
            </p>

            <!-- Verification & QR Details -->
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 40px; border-top: 2px solid #e2e8f0; padding-top: 20px;">
                <div style="text-align: left; font-size: 8.5pt; color: #666;">
                    <div><strong>Certificate #:</strong> @certificate.CertificateNumber</div>
                    <div><strong>Verification Token:</strong> @certificate.VerificationToken</div>
                    <div><strong>Date of Issue:</strong> @certificate.IssueDate.ToString("dd MMMM yyyy")</div>
                    <div style="font-size: 7.5pt; color: #888; margin-top: 2px;">Verify online at: /certificate/verify/@certificate.CertificateNumber</div>
                </div>

                <div>
                    @if (!string.IsNullOrEmpty(qrBase64))
                    {
                        <img src="data:image/png;base64,@qrBase64" style="width: 80px; height: 80px; border: 1px solid #ddd; padding: 3px;" />
                    }
                </div>

                <div style="text-align: center;">
                    <div style="width: 140px; border-bottom: 1.5px solid #1e3a8a; margin-bottom: 4px;"></div>
                    <div style="font-weight: bold; font-size: 9.5pt; color: #1e3a8a;">Controller of Examinations</div>
                    <div style="font-size: 8pt; color: #666;">BISE Sukkur</div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Certificate? certificate;
    private string qrBase64 = "";

    protected override async Task OnInitializedAsync()
    {
        // Lookup by result ID or certificate ID
        var certs = await CertificateService.GetCertificatesAsync();
        certificate = certs.FirstOrDefault(c => c.Id == Id || c.ResultId == Id);

        if (certificate != null)
        {
            var qrBytes = CertificateService.GenerateQrCodePng($"https://bisesukkur.edu.pk/certificate/verify/{certificate.CertificateNumber}");
            qrBase64 = Convert.ToBase64String(qrBytes);
        }
    }

    private async Task Print()
    {
        await JSRuntime.InvokeVoidAsync("biseApp.print");
    }
}
