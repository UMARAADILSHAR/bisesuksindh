@page "/print/roll-slip/{id:int}"
@attribute [Authorize]
@inject IExaminationService ExamService
@inject IWindowService WindowService
@inject ICertificateService CertificateService
@inject IJSRuntime JSRuntime

@if (examForm == null)
{
    <p style="padding: 2rem;">Loading Examination Admit Card / Roll Number Slip...</p>
}
else
{
    <div class="no-print" style="padding: 1rem 2rem; background: #1e293b; color: white; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <strong style="font-size: 1.1rem;">Official Examination Admit Card (Roll Number Slip)</strong>
            <span style="font-size: 0.85rem; color: #94a3b8; margin-left: 1rem;">Roll #: @examForm.RollNumber</span>
        </div>
        <button type="button" class="btn btn-primary" @onclick="Print">
            🖨️ Print Admit Card
        </button>
    </div>

    <div class="print-page" style="display: flex; justify-content: center; padding: 20px; background: #f8fafc;">
        <div style="width: 750px; border: 2px solid #000; padding: 20px; background: white; font-family: 'Times New Roman', Times, serif; font-size: 9pt;">
            <!-- Header -->
            <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 15px;">
                <h2 style="font-size: 1.3rem; font-weight: bold; margin: 0;">
                    BOARD OF INTERMEDIATE & SECONDARY EDUCATION SUKKUR
                </h2>
                <h3 style="font-size: 1.05rem; font-weight: bold; margin: 3px 0;">
                    ADMIT CARD / ROLL NUMBER SLIP - ANNUAL EXAMINATION @(examForm.AcademicYear?.YearName ?? "2026")
                </h3>
                <div style="font-size: 0.85rem; font-weight: bold; color: #333;">
                    @examForm.ClassLevel - @examForm.Group GROUP (@examForm.StudentType.ToUpper())
                </div>
            </div>

            <!-- Candidate Details & Photo -->
            <div style="display: grid; grid-template-columns: 3fr 1fr; gap: 15px; margin-bottom: 15px;">
                <table style="width: 100%; border-collapse: collapse; line-height: 1.7;">
                    <tr>
                        <td style="width: 150px; font-weight: bold;">ROLL NUMBER:</td>
                        <td><strong style="font-size: 1.2rem; font-family: monospace; background: #eee; padding: 2px 8px; border: 1px solid #999;">@examForm.RollNumber</strong></td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold;">REGISTRATION #:</td>
                        <td><code>@(examForm.Enrollment?.EnrollmentNumber ?? "-")</code></td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold;">CANDIDATE NAME:</td>
                        <td><strong style="font-size: 1.05rem; text-transform: uppercase;">@(examForm.Enrollment?.StudentName ?? "-")</strong></td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold;">FATHER'S NAME:</td>
                        <td><strong style="text-transform: uppercase;">@(examForm.Enrollment?.FatherName ?? "-")</strong></td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold;">CNIC / B-FORM:</td>
                        <td><code>@(examForm.Enrollment?.Cnic ?? "-")</code></td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold;">INSTITUTION:</td>
                        <td><strong>@(examForm.School?.Name ?? "School")</strong></td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; color: #b91c1c;">EXAM CENTER:</td>
                        <td><strong style="color: #b91c1c;">@(examForm.ExamCenter?.Name ?? "Designated Board Center")</strong> (@(examForm.ExamCenter?.CenterCode ?? "-"))</td>
                    </tr>
                </table>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div style="width: 110px; height: 130px; border: 1.5px solid #000; display: flex; align-items: center; justify-content: center; background: #fafafa;">
                        <div style="font-size: 8pt; font-weight: bold; text-align: center; color: #777;">CANDIDATE<br />PHOTO</div>
                    </div>
                    @if (!string.IsNullOrEmpty(qrBase64))
                    {
                        <img src="data:image/png;base64,@qrBase64" style="width: 55px; height: 55px; margin-top: 6px;" />
                    }
                </div>
            </div>

            <!-- Examination Timetable -->
            <div style="margin-top: 10px;">
                <div style="font-weight: bold; font-size: 9.5pt; margin-bottom: 4px; border-bottom: 1px solid #000; padding-bottom: 2px;">
                    DATE-SHEET & EXAMINATION PAPERS SCHEDULE:
                </div>
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 8.5pt;">
                    <thead>
                        <tr style="background: #f0f0f0;">
                            <th style="border: 1px solid #333; padding: 4px;">Date</th>
                            <th style="border: 1px solid #333; padding: 4px;">Subject Paper</th>
                            <th style="border: 1px solid #333; padding: 4px;">Session / Timing</th>
                            <th style="border: 1px solid #333; padding: 4px;">Candidate Sign</th>
                            <th style="border: 1px solid #333; padding: 4px;">Invigilator Sign</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in schedules)
                        {
                            <tr>
                                <td style="border: 1px solid #333; padding: 4px; font-weight: bold;">@p.ExamDate.ToString("yyyy-MM-dd")</td>
                                <td style="border: 1px solid #333; padding: 4px;">@p.SubjectName</td>
                                <td style="border: 1px solid #333; padding: 4px;">@p.Session (09:00 AM - 12:00 PM)</td>
                                <td style="border: 1px solid #333; padding: 4px;"></td>
                                <td style="border: 1px solid #333; padding: 4px;"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Candidate Instructions -->
            <div style="margin-top: 15px; font-size: 7.5pt; color: #333; line-height: 1.3; border: 1px solid #999; padding: 6px; background: #fffbe8;">
                <strong>IMPORTANT RULES FOR CANDIDATES:</strong>
                <ol style="margin-left: 15px; margin-top: 2px;">
                    <li>Candidates must bring this Admit Card along with their original B-Form / CNIC into the examination hall daily.</li>
                    <li>Mobile phones, smart watches, bags, and unauthorized study materials are strictly banned inside examination premises.</li>
                    <li>Candidates must report to the examination center at least 30 minutes before the paper start time.</li>
                </ol>
            </div>

            <!-- Signatures -->
            <div style="display: flex; justify-content: space-between; margin-top: 30px; padding-top: 6px; font-size: 8.5pt;">
                <div>Candidate's Signature</div>
                <div>Principal's Signature & Stamp</div>
                <div style="font-weight: bold;">Controller of Examinations</div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private ExaminationForm? examForm;
    private List<ExamSchedule> schedules = new();
    private string qrBase64 = "";

    protected override async Task OnInitializedAsync()
    {
        examForm = await ExamService.GetExaminationFormByIdAsync(Id);
        if (examForm != null)
        {
            schedules = await ExamService.GetExamSchedulesAsync(examForm.AcademicYearId, examForm.ClassLevel);
            var qrBytes = CertificateService.GenerateQrCodePng($"BISE-ADMIT|ROLL:{examForm.RollNumber}|NAME:{examForm.Enrollment?.StudentName}|CTR:{examForm.ExamCenter?.CenterCode}");
            qrBase64 = Convert.ToBase64String(qrBytes);
        }
    }

    private async Task Print()
    {
        await JSRuntime.InvokeVoidAsync("biseApp.print");
    }
}
