@page "/superadmin/verification"
@attribute [Authorize(Roles = "SuperAdmin")]
@using BiseSukkur.Application.Commands.Challan
@using MediatR
@inject IChallanService ChallanService
@inject ISender Mediator
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IToastNotificationService ToastService

<div class="card-header-flex">
    <div>
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">Challan Invoices Verification Workbench</h2>
        <p style="color: var(--text-secondary); font-size: 0.875rem;">Verify bank payment receipts, auto-generate official registration sequences, or reject invoices with audit notes</p>
    </div>
</div>

<!-- Filters Bar -->
<div class="card-surface" style="padding: 1rem 1.25rem;">
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; justify-content: space-between;">
        <div style="flex: 1; min-width: 250px;">
            <input type="text" class="form-control" placeholder="Search by invoice # (e.g. KH1-001-001) or school name..." @bind="searchTerm" @bind:event="oninput" @bind:after="LoadInvoices" />
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <button type="button" class="btn @(selectedStatus == null ? "btn-primary" : "btn-secondary") btn-sm" @onclick='() => ChangeStatusFilter(null)'>
                All Invoices
            </button>
            <button type="button" class="btn @(selectedStatus == InvoiceStatus.Pending ? "btn-warning" : "btn-secondary") btn-sm" @onclick='() => ChangeStatusFilter(InvoiceStatus.Pending)'>
                ⏳ Pending
            </button>
            <button type="button" class="btn @(selectedStatus == InvoiceStatus.Verified ? "btn-success" : "btn-secondary") btn-sm" @onclick='() => ChangeStatusFilter(InvoiceStatus.Verified)'>
                ✓ Verified
            </button>
            <button type="button" class="btn @(selectedStatus == InvoiceStatus.Rejected ? "btn-danger" : "btn-secondary") btn-sm" @onclick='() => ChangeStatusFilter(InvoiceStatus.Rejected)'>
                ✕ Rejected
            </button>
        </div>
    </div>
</div>

<!-- Invoices Table -->
<div class="card-surface" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="grid-table">
            <thead>
                <tr>
                    <th style="width: 16%;">Invoice #</th>
                    <th style="width: 24%;">School Name</th>
                    <th style="width: 16%;">Type & Batch</th>
                    <th style="width: 10%;">Students</th>
                    <th style="width: 12%; text-align: right;">Amount</th>
                    <th style="width: 10%;">Status</th>
                    <th style="width: 12%; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!invoices.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">No challan invoices found for this criteria.</td>
                    </tr>
                }
                else
                {
                    @foreach (var inv in invoices)
                    {
                        <tr>
                            <td>
                                <span class="cell-mono" style="font-weight: 700; color: var(--brand-primary);">@inv.InvoiceNumber</span>
                            </td>
                            <td>
                                <div><strong>@(inv.School?.Name ?? "School ID " + inv.SchoolId)</strong></div>
                                <div style="font-size: 0.75rem; color: var(--text-muted);">SEMIS: @(inv.School?.SemisCode ?? "-") | District: @(inv.School?.District?.Name ?? "-")</div>
                            </td>
                            <td>
                                <span class="badge @(inv.InvoiceType == "enrollment" ? "badge-info" : "badge-purple")">
                                    @inv.InvoiceType.ToUpper()
                                </span>
                                <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                    @inv.ClassGroupStudentType
                                </div>
                            </td>
                            <td style="text-align: center;"><strong>@inv.StudentCount</strong></td>
                            <td style="font-weight: 700; color: #047857; text-align: right;" class="cell-mono">
                                Rs. @inv.Amount.ToString("N0")
                            </td>
                            <td>
                                <span class="badge @(inv.Status == InvoiceStatus.Verified ? "badge-success" : inv.Status == InvoiceStatus.Pending ? "badge-warning" : "badge-danger")">
                                    @inv.Status
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <div class="btn-action-group" style="justify-content: flex-end;">
                                    <button type="button" class="btn-action" @onclick="() => InspectInvoice(inv)" title="Inspect Invoice Items">
                                        Inspect
                                    </button>
                                    @if (inv.Status == InvoiceStatus.Pending)
                                    {
                                        <button type="button" class="btn-action btn-action-primary" @onclick="() => OpenVerificationModal(inv)" title="Record payment and verify challan">
                                            Verify
                                        </button>
                                        <button type="button" class="btn-action btn-action-danger" @onclick="() => OpenRejectModal(inv)" title="Reject Invoice">
                                            ✕
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Inspect Modal -->
@if (inspectedInvoice != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-dialog-custom" style="max-width: 800px;">
            <div class="modal-header-custom">
                <div>
                    <h3 style="font-size: 1.15rem; font-weight: 700;">Challan Invoice #@inspectedInvoice.InvoiceNumber</h3>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">School: @inspectedInvoice.School?.Name (SEMIS: @inspectedInvoice.School?.SemisCode)</p>
                </div>
                <button type="button" @onclick="() => inspectedInvoice = null" style="background: none; border: none; font-size: 1.4rem; cursor: pointer;">×</button>
            </div>
            <div class="modal-body-custom">
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.25rem;">
                    <div style="background: var(--bg-app); padding: 0.75rem; border-radius: var(--radius-sm);">
                        <div class="kpi-label">Type</div>
                        <div style="font-weight: 700;">@inspectedInvoice.InvoiceType.ToUpper()</div>
                    </div>
                    <div style="background: var(--bg-app); padding: 0.75rem; border-radius: var(--radius-sm);">
                        <div class="kpi-label">Candidates</div>
                        <div style="font-weight: 700;">@inspectedInvoice.StudentCount</div>
                    </div>
                    <div style="background: var(--bg-app); padding: 0.75rem; border-radius: var(--radius-sm);">
                        <div class="kpi-label">Total Amount</div>
                        <div style="font-weight: 700; color: #047857;">Rs. @inspectedInvoice.Amount.ToString("N0")</div>
                    </div>
                    <div style="background: var(--bg-app); padding: 0.75rem; border-radius: var(--radius-sm);">
                        <div class="kpi-label">Status</div>
                        <div style="font-weight: 700;">@inspectedInvoice.Status</div>
                    </div>
                </div>

                @if (inspectedInvoice.Status == InvoiceStatus.Verified)
                {
                    <div class="alert-banner success" style="margin-bottom: 1.25rem;">
                        <strong>Payment reconciliation:</strong>
                        <span>Ref. @(inspectedInvoice.PaymentReference ?? "legacy verification")</span>
                        <span>· @(inspectedInvoice.PaymentMethod ?? "Not recorded")</span>
                        @if (inspectedInvoice.PaymentReceivedAt.HasValue)
                        {
                            <span>· Received @inspectedInvoice.PaymentReceivedAt.Value.ToString("dd MMM yyyy")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(inspectedInvoice.PaymentVerifiedByUsername))
                        {
                            <span>· Verified by @inspectedInvoice.PaymentVerifiedByUsername</span>
                        }
                    </div>
                }

                <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem;">Included Candidate Students:</h4>
                <div class="table-responsive" style="max-height: 350px;">
                    <table class="grid-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>Father Name</th>
                                <th>CNIC / B-Form</th>
                                <th>Class & Group</th>
                                <th>Allotted Reg #</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 1; }
                            @foreach (var item in inspectedInvoice.Items.Where(it => it.IsIncluded))
                            {
                                <tr>
                                    <td style="text-align: center;">@(idx++)</td>
                                    <td><strong style="color: var(--text-primary);">@(item.Enrollment?.StudentName?.ToUpperInvariant() ?? "-")</strong></td>
                                    <td>@(item.Enrollment?.FatherName?.ToUpperInvariant() ?? "-")</td>
                                    <td><span class="cell-mono">@(item.Enrollment?.Cnic ?? "-")</span></td>
                                    <td>@(item.Enrollment?.ClassLevel) (@(item.Enrollment?.Group))</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Enrollment?.EnrollmentNumber))
                                        {
                                            <span class="badge badge-success">@item.Enrollment.EnrollmentNumber</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Pending Verification</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer-custom">
                <a href="api/pdf/student-list/@inspectedInvoice.Id" download class="btn btn-secondary">
                    📄 Candidate List PDF
                </a>
                <a href="api/pdf/bank-challan/@inspectedInvoice.Id" download class="btn btn-secondary">
                    🏦 Bank Slip PDF
                </a>
                <button type="button" class="btn btn-secondary" @onclick="() => inspectedInvoice = null">Close</button>
                @if (inspectedInvoice.Status == InvoiceStatus.Pending)
                {
                    <button type="button" class="btn btn-success" @onclick="() => OpenVerificationModal(inspectedInvoice)">
                        ✓ Verify Payment & Allot Sequences
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Payment Verification Modal -->
@if (verifyingInvoice != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-dialog-custom">
            <div class="modal-header-custom">
                <div>
                    <h3 style="font-size: 1.15rem; font-weight: 700;">Verify Payment for #@verifyingInvoice.InvoiceNumber</h3>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">Rs. @verifyingInvoice.Amount.ToString("N0") for @verifyingInvoice.StudentCount candidate(s)</p>
                </div>
                <button type="button" @onclick="CloseVerificationModal" style="background: none; border: none; font-size: 1.4rem; cursor: pointer;" aria-label="Close payment verification">×</button>
            </div>
            <div class="modal-body-custom">
                <p style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 1rem;">
                    Record the bank receipt before releasing candidates. A payment reference can only be used once.
                </p>
                <div class="form-group">
                    <label class="form-label" for="payment-reference">Bank transaction / receipt reference</label>
                    <input id="payment-reference" class="form-control" @bind="paymentReference" maxlength="100" autocomplete="off" placeholder="e.g. HBL-20260820-123456" required />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label" for="payment-date">Payment date</label>
                        <input id="payment-date" type="date" class="form-control" @bind="paymentReceivedAt" @bind:format="yyyy-MM-dd" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="payment-method">Payment method</label>
                        <select id="payment-method" class="form-select" @bind="paymentMethod">
                            <option>Bank deposit</option>
                            <option>Bank transfer</option>
                            <option>Online bank payment</option>
                            <option>Mobile wallet</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" @onclick="CloseVerificationModal" disabled="@isVerifyingPayment">Cancel</button>
                <button type="button" class="btn btn-success" @onclick="ConfirmPaymentVerification" disabled="@isVerifyingPayment">
                    @(isVerifyingPayment ? "Verifying payment..." : "Confirm Payment & Release Candidates")
                </button>
            </div>
        </div>
    </div>
}

<!-- Reject Modal -->
@if (rejectingInvoice != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-dialog-custom">
            <div class="modal-header-custom">
                <h3 style="font-size: 1.15rem; font-weight: 700; color: #b91c1c;">Reject Challan Invoice #@rejectingInvoice.InvoiceNumber</h3>
                <button type="button" @onclick="() => rejectingInvoice = null" style="background: none; border: none; font-size: 1.4rem; cursor: pointer;">×</button>
            </div>
            <div class="modal-body-custom">
                <p style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 1rem;">
                    Please state the explicit reason for rejecting this challan. The candidate records will be released back to the school so they can re-generate a corrected challan.
                </p>

                <div class="form-group">
                    <label class="form-label">Rejection Reason</label>
                    <textarea class="form-control" rows="3" @bind="rejectionReason" placeholder="e.g. Bank payment scroll mismatch / Incorrect fee slab applied..." required></textarea>
                </div>

                <div class="modal-footer-custom" style="padding: 1rem 0 0 0; margin-top: 1rem;">
                    <button type="button" class="btn btn-secondary" @onclick="() => rejectingInvoice = null">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmReject">Confirm Rejection</button>
                </div>
            </div>
        </div>
    </div>
}

<ToastNotification Message="@toastMessage" Type="@toastType" OnClose="() => toastMessage = null" />

@code {
    private List<Invoice> invoices = new();
    private string searchTerm = "";
    private InvoiceStatus? selectedStatus;

    private Invoice? inspectedInvoice;
    private Invoice? verifyingInvoice;
    private Invoice? rejectingInvoice;
    private string rejectionReason = "";
    private string paymentReference = "";
    private DateTime paymentReceivedAt = DateTime.UtcNow.Date;
    private string paymentMethod = "Bank deposit";
    private bool isVerifyingPayment;

    private string? toastMessage;
    private string toastType = "success";

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();
    }

    private async Task LoadInvoices()
    {
        invoices = await ChallanService.GetAllInvoicesAsync(
            string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            selectedStatus
        );
    }

    private async Task ChangeStatusFilter(InvoiceStatus? status)
    {
        selectedStatus = status;
        await LoadInvoices();
    }

    private async Task InspectInvoice(Invoice inv)
    {
        inspectedInvoice = await ChallanService.GetInvoiceByIdAsync(inv.Id);
    }

    private void OpenVerificationModal(Invoice invoice)
    {
        verifyingInvoice = invoice;
        inspectedInvoice = null;
        paymentReference = "";
        paymentReceivedAt = DateTime.UtcNow.Date;
        paymentMethod = "Bank deposit";
    }

    private void CloseVerificationModal()
    {
        if (!isVerifyingPayment)
        {
            verifyingInvoice = null;
        }
    }

    private async Task ConfirmPaymentVerification()
    {
        if (verifyingInvoice == null || isVerifyingPayment)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(paymentReference))
        {
            ToastService.ShowWarning("Enter the bank transaction or receipt reference before verifying payment.", "Payment Reference Required", 7000);
            return;
        }

        var username = AuthStateProvider.CurrentUserSession?.Username;
        if (string.IsNullOrWhiteSpace(username))
        {
            ToastService.ShowError("Your session is no longer available. Please sign in again.", "Verification Failed", 7000);
            return;
        }

        isVerifyingPayment = true;
        try
        {
            var result = await Mediator.Send(new VerifyChallanCommand(
                verifyingInvoice.Id,
                paymentReference,
                paymentReceivedAt,
                paymentMethod));

            if (result.IsSuccess)
            {
                ToastService.ShowSuccess(
                    "Payment verified and the challan candidates were released successfully.",
                    "Challan Reconciled",
                    7000);
                verifyingInvoice = null;
                await LoadInvoices();
            }
            else
            {
                ToastService.ShowError(result.Error.Message, "Verification Failed", 7000);
            }
        }
        finally
        {
            isVerifyingPayment = false;
        }
    }

    private void OpenRejectModal(Invoice inv)
    {
        rejectingInvoice = inv;
        rejectionReason = "";
    }

    private async Task ConfirmReject()
    {
        if (rejectingInvoice == null || string.IsNullOrWhiteSpace(rejectionReason))
        {
            ToastService.ShowWarning("Please enter a valid rejection reason.", "Missing Reason", 7000);
            return;
        }

        var username = AuthStateProvider.CurrentUserSession?.Username ?? "superadmin";
        var invNumber = rejectingInvoice.InvoiceNumber;
        await ChallanService.RejectChallanAsync(rejectingInvoice.Id, rejectionReason, username);
        ToastService.ShowWarning($"Challan #{invNumber} has been rejected and candidate students released.", "Challan Rejected", 7000);
        rejectingInvoice = null;
        inspectedInvoice = null;
        await LoadInvoices();
    }
}
