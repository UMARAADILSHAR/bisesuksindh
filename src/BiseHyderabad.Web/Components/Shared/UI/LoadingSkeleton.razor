<div class="skeleton-wrapper">
    @for (int i = 0; i < Rows; i++)
    {
        <div class="skeleton-row">
            <div class="skeleton-pulse" style="width: 20%; height: 1.25rem;"></div>
            <div class="skeleton-pulse" style="width: 35%; height: 1.25rem;"></div>
            <div class="skeleton-pulse" style="width: 15%; height: 1.25rem;"></div>
            <div class="skeleton-pulse" style="width: 15%; height: 1.25rem;"></div>
            <div class="skeleton-pulse" style="width: 10%; height: 1.25rem;"></div>
        </div>
    }
</div>

@code {
    [Parameter] public int Rows { get; set; } = 5;
}
