@using BiseHyderabad.Web.Services
@inject IToastNotificationService ToastService
@implements IDisposable

<div class="toast-container-global">
    @foreach (var toast in ToastService.Toasts)
    {
        var toastClass = toast.Type switch
        {
            ToastType.Success => "toast-item-success",
            ToastType.Error => "toast-item-error",
            ToastType.Warning => "toast-item-warning",
            _ => "toast-item-info"
        };

        var iconSymbol = toast.Type switch
        {
            ToastType.Success => "✓",
            ToastType.Error => "✕",
            ToastType.Warning => "⚠",
            _ => "ℹ"
        };

        <div class="toast-item @toastClass" key="@toast.Id">
            <div class="toast-header-row">
                <div class="toast-title-box">
                    <span class="toast-icon">@iconSymbol</span>
                    <strong class="toast-title">@toast.Title</strong>
                </div>
                <button type="button" class="toast-close-btn" @onclick="() => ToastService.Dismiss(toast.Id)" title="Close">×</button>
            </div>
            <div class="toast-body-text">
                @toast.Message
            </div>
            <div class="toast-progress-track">
                <div class="toast-progress-bar" style="animation-duration: @(toast.DurationMs)ms;"></div>
            </div>
        </div>
    }
</div>

<style>
.toast-container-global {
    position: fixed;
    top: 20px;
    right: 24px;
    z-index: 999999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 380px;
    max-width: calc(100vw - 32px);
    pointer-events: none;
}

.toast-item {
    pointer-events: auto;
    border-radius: 12px;
    padding: 14px 16px;
    color: #ffffff;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
    position: relative;
    overflow: hidden;
    animation: toastSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    backdrop-filter: blur(8px);
}

.toast-item-success {
    background: linear-gradient(135deg, #065f46 0%, #047857 50%, #059669 100%);
    border: 1px solid rgba(52, 211, 153, 0.4);
}

.toast-item-error {
    background: linear-gradient(135deg, #991b1b 0%, #b91c1c 50%, #dc2626 100%);
    border: 1px solid rgba(248, 113, 113, 0.4);
}

.toast-item-warning {
    background: linear-gradient(135deg, #92400e 0%, #b45309 50%, #d97706 100%);
    border: 1px solid rgba(251, 191, 36, 0.4);
}

.toast-item-info {
    background: linear-gradient(135deg, #075985 0%, #0369a1 50%, #0284c7 100%);
    border: 1px solid rgba(56, 189, 248, 0.4);
}

.toast-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.toast-title-box {
    display: flex;
    align-items: center;
    gap: 8px;
}

.toast-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    font-size: 0.8125rem;
    font-weight: 800;
}

.toast-title {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
}

.toast-close-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 4px;
    border-radius: 4px;
    transition: all 0.2s ease;
}

.toast-close-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.2);
}

.toast-body-text {
    font-size: 0.845rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.95);
    word-break: break-word;
}

.toast-progress-track {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: rgba(0, 0, 0, 0.25);
}

.toast-progress-bar {
    height: 100%;
    background: rgba(255, 255, 255, 0.85);
    width: 100%;
    animation-name: toastProgressCountdown;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
}

@@keyframes toastSlideIn {
    0% {
        opacity: 0;
        transform: translateX(60px) scale(0.95);
    }
    100% {
        opacity: 1;
        transform: translateX(0) scale(1);
    }
}

@@keyframes toastProgressCountdown {
    0% {
        width: 100%;
    }
    100% {
        width: 0%;
    }
}
</style>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += OnToastChanged;
    }

    private void OnToastChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ToastService.OnChange -= OnToastChanged;
    }
}
